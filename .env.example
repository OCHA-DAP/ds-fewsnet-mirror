# Team dev Postgres (via ocha-stratus). Read creds for exports, write creds for refresh.
DSCI_AZ_DB_DEV_HOST=
DSCI_AZ_DB_DEV_UID=
DSCI_AZ_DB_DEV_PW=
DSCI_AZ_DB_DEV_UID_WRITE=
DSCI_AZ_DB_DEV_PW_WRITE=
PGSSLMODE=require

# Team dev blob (via ocha-stratus) — unit geometry geojsons land in the
# `projects` container under ds-fewsnet-mirror/. Write SAS for refresh only.
DSCI_AZ_BLOB_DEV_SAS=
DSCI_AZ_BLOB_DEV_SAS_WRITE=
